- real_page = page["real_page"]
- project_name = real_page.project ? site.projects[real_page.project].name : ''
- project_icon = real_page.project ? site.projects[real_page.project].icon : ''
- page_title = "#{real_page.title ? real_page.title : real_page.simple_name.capitalize}"
.jumbotron.small
  .ui.container
    - buttons_partial = real_page.project_buttons_partial.nil? ? 'project/empty-buttons.html.haml' : real_page.project_buttons_partial
    %h1
      %span
        %i{:class => "grid #{project_icon&.gsub('-',' ')}"}
        = project_name
      %span.jumbotron-buttons
        = partial( buttons_partial, { "real_page" => real_page, "row" => 1 } )
    %h2
      %span
        = page_title
      %span.jumbotron-buttons.mobile.hidden
        = partial( buttons_partial, { "real_page" => real_page, "row" => 2 } )

