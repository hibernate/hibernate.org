- real_page = page["real_page"]
- project_description = site.projects[real_page.project]
- project_name = real_page.project ? project_description.name : ''
- series = project_description.release_series[real_page.series_version]
- real_page.title = "#{series.version} series"
.jumbotron.small
  .ui.container
    - buttons_partial = real_page.project_buttons_partial.nil? ? 'project/empty-buttons.html.haml' : real_page.project_buttons_partial
    %h1
      %span
        = project_name
      %span.jumbotron-buttons
        = partial( buttons_partial, { "real_page" => real_page, "row" => 1 } )
    %h2
      %span
        = real_page.title
      = partial( 'project/series-status-label.html.haml', { "project_name" => project_name, "series" => series, "classes" => "tag" } )
      %span.jumbotron-buttons.mobile.hidden
        = partial( buttons_partial, { "real_page" => real_page, "row" => 2 } )

