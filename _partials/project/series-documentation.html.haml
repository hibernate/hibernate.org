- project_description = page.project
- series = page.series
- anchors = page.anchors
- categories_filter = page.categories_filter
- doc_content = false

- categories = doc_categories(project_description, series)
- category_order = ['introduction', 'migration', 'reference', 'api', 'reports']
- category_labels = { 'introduction' => 'Introduction', 'migration' => 'Migration', 'reference' => 'Reference', 'api' => 'API', 'reports' => 'Reports' }

- if anchors && categories['introduction'] && !categories['introduction'].empty?
  %a{:id => "getting_started"}
- if anchors && categories['migration'] && !categories['migration'].empty?
  %a{:id => "migrate"}

.ui.stackable.grid.categories
  - category_order.each do |cat_key|
    - next if categories_filter && !categories_filter.include?(cat_key)
    - entries = categories[cat_key]
    - next if entries.nil? || entries.empty?
    - doc_content = true
    .ui.row
      .ui.three.wide.column.right.aligned
        %span.ui.sub.header.faded= category_labels[cat_key]
      .ui.thirteen.wide.column
        - entries.each do |entry|
          %span.ui.basic.buttons.compact{:data => entry.description ? {:html => entry.description, :position => "top center"} : Hash.new}
            %a.ui.active.button{:href => entry.html_url ? entry.html_url : entry.pdf_url}
              = entry.name
            - if entry.html_url
              %a.ui.button{:href => entry.html_url}
                HTML&nbsp;
                %i.icon.file.text.outline<>
            - if entry.pdf_url
              %a.ui.button{:href => entry.pdf_url}
                PDF&nbsp;
                %i.icon.file.pdf.outline<>
  - if not doc_content
    .ui.row
      .ui.sixteen.wide.column
        %p
          Documentation is not currently available for this series.
