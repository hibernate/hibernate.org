- current_path = page['real_page'].output_path.sub(/index\.html$/, "").sub(/\.html$/,"/")
- support_active = current_path.start_with?("/support/")

.item
  %a.title{:class => "#{(support_active ? "active" : "")}"}
    %i.grid.icon.doctor
    %i.dropdown.icon
    %strong Support
  .content{:class => "#{(support_active ? "active" : "")}"}
    .menu.external-links
      - item_active = (current_path == '/support/')
      %a.item(href="/support/"){:class => "#{(item_active ? "active" : "")}"}
        %i.grid.icon.life.ring
        Getting help
      - href = "/support/compatibility-policy/"
      %a.item{:href => href, :class => "#{(current_path.start_with?( href ) ? "active" : "")}"}
        %i.grid.icon.history
        Compatibility Policy
      - href = "/support/maintenance-policy/"
      %a.item{:href => href, :class => "#{(current_path.start_with?( href ) ? "active" : "")}"}
        %i.grid.icon.wrench
        Maintenance Policy
      - href = "/support/long-term/"
      %a.item{:href => href, :class => "#{(current_path == href ? "active" : "")}"}
        %i.grid.icon.check.circle
        Long-Term Support
      - href = "/support/end-of-life/"
      %a.item{:href => href, :class => "#{(current_path == href ? "active" : "")}"}
        %i.grid.icon.x
        End-of-Life Support
